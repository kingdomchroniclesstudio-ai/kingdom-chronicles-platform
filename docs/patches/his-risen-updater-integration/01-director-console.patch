+function updateStatusLabel(result){
+ const labels={first_observation_needs_manual_baseline:'First observation — manual baseline needed',release_metadata_changed_since_last_check:'Release metadata changed since last check',model_metadata_changed_since_last_check:'Model metadata changed since last check',no_change_since_last_check:'No metadata change since last check'};
+ return labels[result]||String(result||'No update status inferred').replaceAll('_',' ');
