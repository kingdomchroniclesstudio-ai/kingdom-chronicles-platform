+function renderUpdateResults(data){
+ const host=$('updateCheckResults');
+ const results=Array.isArray(data.sources)?data.sources:[];
+ const summary=Number(data.change_candidates_requiring_manual_review)||0;
+ $('updateCheckStatus').textContent=`Check finished. ${summary} metadata candidate(s) need manual review. No changes were applied; automatic install is off.`;
+ host.innerHTML=results.map(item=>{
+  const detail=item.release?.tag_name?`Release: ${esc(item.release.tag_name)}`:item.model?.revision?`Model revision: ${esc(String(item.model.revision).slice(0,12))}…`:'';
+  const extra=item.error?`<div class="small bad">${esc(item.error)}</div>`:item.note?`<div class="small muted">${esc(item.note)}</div>`:'';
+  const status=item.change_status?updateStatusLabel(item.change_status):item.reachable?(item.metadata_status||'Source reachable'):'Source unavailable';
+  const badge=item.reachable===true?'ok':item.reachable===false?'bad':'warn';
+  const http=item.http_status?` · HTTP ${esc(item.http_status)}`:'';
+  return `<div class="item"><div class="row"><b class="grow">${esc(item.source||'Update source')}</b><span class="pill ${badge}">${esc(item.reachable===true?'REACHABLE':item.reachable===false?'UNREACHABLE':'LOCAL')}</span></div><div class="small">${esc(status)}${http}</div>${detail?`<div class="small muted">${detail}</div>`:''}${extra}</div>`;
+ }).join('')||'<div class="muted small">No source results were returned.</div>';
+}
+async function runUpdateCheck(){
